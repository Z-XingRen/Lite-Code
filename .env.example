# Legacy fallback only. Prefer .lite.toml for provider profiles.

# DeepSeek uses its Anthropic-compatible endpoint by default.
LITE_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
LITE_DEEPSEEK_API_KEY=
LITE_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional shared right.codes key. Used by OpenAI-compatible and
# Anthropic-compatible profiles when provider-specific keys are empty.
LITE_RIGHT_CODES_API_KEY=

# OpenAI-compatible endpoint.
LITE_OPENAI_API_BASE=https://api.openai.com/v1
LITE_OPENAI_API_KEY=
LITE_OPENAI_MODEL=gpt-5.4

# Anthropic-compatible endpoint.
LITE_ANTHROPIC_API_BASE=https://api.anthropic.com
LITE_ANTHROPIC_API_KEY=
LITE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
LITE_SECRET_ENV_NAMES=
